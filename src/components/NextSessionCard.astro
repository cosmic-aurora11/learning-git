---
import siteData from '../data/siteData.json';

const { nextSession } = siteData;
---

<div class="card next-session">
  <h3>Next Session</h3>
  <p><strong>{nextSession.date}</strong> · {nextSession.time}</p>
  {nextSession.location && <p>📍 {nextSession.location}</p>}
  {nextSession.note && <p class="muted">{nextSession.note}</p>}
</div>

<style>
  .muted {
    color: var(--muted);
  }
</style>
