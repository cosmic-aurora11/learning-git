---
import siteData from '../data/siteData.json';

const { session } = Astro.props;
const nextSession = session || siteData.nextSession;
---

<div class="card next-session star-widget star-widget--elevated" aria-label="Next session details">
  <div class="star-widget__header">
    <span class="star-widget__star" aria-hidden="true">✦</span>
    <span>Next Session</span>
  </div>
  <h3 class="star-widget__date">{nextSession.date}</h3>
  <p class="star-widget__detail"><span class="star-widget__icon" aria-hidden="true">🕒</span>{nextSession.time}</p>
  {nextSession.location && (
    <p class="star-widget__detail">
      <span class="star-widget__icon" aria-hidden="true">📍</span>
      <span>{nextSession.location}</span>
    </p>
  )}
  {nextSession.note && <p class="muted">{nextSession.note}</p>}
</div>

<style>
  .muted {
    color: var(--muted);
  }

  .star-widget__date {
    margin-top: var(--space-3);
  }
</style>
