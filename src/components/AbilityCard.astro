---
import { marked } from 'marked';

const {
  name,
  summary = '',
  details = '',
  tags = [],
  uses = '',
  recharge = '',
  id
} = Astro.props;

const panelId = id ?? `ability-panel-${Math.random().toString(36).slice(2, 9)}`;
const detailsHtml = details ? marked.parse(details) : '';
---

<div class="ability-card" data-accordion-card>
  <button
    class="ability-card__toggle"
    type="button"
    aria-expanded="false"
    aria-controls={panelId}
    data-accordion-toggle
  >
    <div class="ability-card__top">
      <div class="ability-card__titles">
        <h4>{name}</h4>
        {summary && <p class="ability-card__summary">{summary}</p>}
      </div>
      <span class="ability-card__chevron" aria-hidden="true">▾</span>
    </div>
    {tags.length > 0 && (
      <div class="ability-card__tags">
        {tags.map((tag) => (
          <span class="ability-card__tag">{tag}</span>
        ))}
      </div>
    )}
  </button>
  <div class="ability-card__panel" id={panelId} role="region" aria-hidden="true" data-accordion-panel>
    {details && <div class="ability-card__details" set:html={detailsHtml} />}
    {(uses || recharge) && (
      <div class="ability-card__meta">
        {uses && <span>Uses: {uses}</span>}
        {recharge && <span>Recharge: {recharge}</span>}
      </div>
    )}
  </div>
</div>

<style>
  .ability-card {
    border-radius: 16px;
    border: 1px solid rgba(148, 163, 184, 0.18);
    background: rgba(15, 23, 42, 0.45);
    box-shadow: 0 10px 24px rgba(2, 6, 23, 0.25);
    overflow: hidden;
  }

  .ability-card.is-open {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    box-shadow: 0 12px 28px rgba(2, 6, 23, 0.35);
  }

  .ability-card__toggle {
    width: 100%;
    text-align: left;
    border: none;
    background: transparent;
    color: inherit;
    padding: var(--space-4);
    display: grid;
    gap: var(--space-3);
    cursor: pointer;
  }

  .ability-card__toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 16px;
  }

  .ability-card__top {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .ability-card__titles h4 {
    margin: 0;
    font-size: var(--text-lg);
  }

  .ability-card__summary {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .ability-card__chevron {
    font-size: 1.1rem;
    color: var(--muted);
    transform: rotate(0deg);
    transition: transform 200ms ease;
  }

  .ability-card.is-open .ability-card__chevron {
    transform: rotate(180deg);
  }

  .ability-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .ability-card__tag {
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
  }

  .ability-card__panel {
    padding: 0 var(--space-4);
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 220ms ease, opacity 220ms ease;
  }

  .ability-card.is-open .ability-card__panel {
    opacity: 1;
    padding-bottom: var(--space-4);
  }

  .ability-card__details {
    font-size: var(--text-sm);
    color: var(--text);
  }

  .ability-card__details :global(p) {
    margin: 0 0 0.5rem;
  }

  .ability-card__details :global(p:last-child) {
    margin-bottom: 0;
  }

  .ability-card__details :global(ul),
  .ability-card__details :global(ol) {
    margin: 0 0 0.5rem;
    padding-left: 1.1rem;
  }

  .ability-card__details :global(li) {
    margin: 0.15rem 0;
  }

  .ability-card__meta {
    margin-top: var(--space-3);
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.2rem;
    font-size: var(--text-xs);
    color: var(--muted);
  }
</style>
