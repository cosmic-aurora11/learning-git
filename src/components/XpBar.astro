---
const { xpPips } = Astro.props;
const tooltipId = `xp-tooltip-${Math.random().toString(36).slice(2, 9)}`;
const rawPips = Number.isFinite(xpPips) ? xpPips : Number(xpPips ?? 0);
const safePips = Number.isFinite(rawPips) ? rawPips : 0;
const clampedPips = Math.min(6, Math.max(0, safePips));
const fillPercent = (clampedPips / 6) * 100;
---

<div class="xp-bar" style={`--xp-fill: ${fillPercent}%`} tabindex="0" aria-describedby={tooltipId}>
  <span class="xp-label">XP</span>
  <div class="xp-track" aria-hidden="true">
    <div class="xp-fill"></div>
  </div>
  <span class="xp-tooltip" id={tooltipId} role="tooltip">Progress toward your next level.</span>
</div>

<style>
  .xp-bar {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    position: relative;
    outline: none;
  }

  .xp-label {
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .xp-track {
    position: relative;
    height: 14px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    background: rgba(15, 23, 42, 0.55);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--accent) 15%, transparent),
      0 0 14px color-mix(in srgb, var(--accent) 24%, transparent);
    overflow: hidden;
  }

  .xp-tooltip {
    position: absolute;
    left: 0;
    top: calc(100% + 0.5rem);
    padding: 0.4rem 0.65rem;
    border-radius: 10px;
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    background: rgba(2, 6, 23, 0.92);
    box-shadow: 0 8px 18px rgba(2, 6, 23, 0.35);
    color: var(--text);
    font-size: var(--text-xs);
    max-width: 220px;
    opacity: 0;
    transform: translateY(-4px);
    pointer-events: none;
    transition: opacity 180ms ease, transform 180ms ease;
    z-index: 2;
  }

  .xp-bar:hover .xp-tooltip,
  .xp-bar:focus-within .xp-tooltip {
    opacity: 1;
    transform: translateY(0);
  }

  .xp-fill {
    height: 100%;
    width: var(--xp-fill);
    border-radius: inherit;
    background:
      linear-gradient(
        120deg,
        rgba(255, 255, 255, 0.15) 0%,
        rgba(255, 255, 255, 0.45) 35%,
        rgba(255, 255, 255, 0.1) 70%
      ),
      linear-gradient(90deg, #1fb56a, #39e27f);
    box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.25);
    transition: width 420ms ease;
  }

  @media (max-width: 600px) {
    .xp-bar {
      grid-template-columns: auto;
      gap: var(--space-2);
    }

    .xp-track {
      width: 100%;
    }
  }
</style>
