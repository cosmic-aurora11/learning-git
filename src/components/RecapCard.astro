---
const { recap } = Astro.props;
const sessionDisplay = recap.data.sessionLabel ?? recap.data.sessionNumber;
const dateDisplay = recap.data.dateLabel ?? recap.data.date;
---

<article class="card">
  <h3>{recap.data.title}</h3>
  <p class="muted">Session {sessionDisplay} · {dateDisplay}</p>
  <p>{recap.data.summary}</p>
  <a class="button" href={`/recaps/${recap.slug}`}>Read Full Recap</a>
</article>

<style>
  .muted {
    color: var(--muted);
    margin: 0.3rem 0 0.6rem;
  }

  h3 {
    margin-bottom: 0.4rem;
  }

  p:not(.muted) {
    margin: 0.5rem 0 1rem;
  }
</style>
