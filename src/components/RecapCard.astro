---
const { recap } = Astro.props;
---

<article class="card">
  <div class="tag-list">
    {recap.data.tags.map((tag) => (
      <span class="chip" key={tag}>{tag}</span>
    ))}
  </div>
  <h3>{recap.data.title}</h3>
  <p class="muted">Session {recap.data.sessionNumber} · {recap.data.date}</p>
  <p>{recap.data.summary}</p>
  <a class="button" href={`/recaps/${recap.slug}`}>Read Full Recap</a>
</article>

<style>
  .muted {
    color: var(--muted);
    margin: 0.3rem 0 0.6rem;
  }

  h3 {
    margin-bottom: 0.4rem;
  }

  p:not(.muted) {
    margin: 0.5rem 0 1rem;
  }
</style>
