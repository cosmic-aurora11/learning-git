---
const { types = [], feedId = '', includeAll = true, size = 'md' } = Astro.props;
const chipTypes = includeAll ? [{ value: 'all', label: 'All' }, ...types] : types;
---

<div class={`filter-chips ${size === 'sm' ? 'is-compact' : ''}`} data-feed-chips={feedId}>
  {chipTypes.map((type, index) => (
    <button
      class={`chip filter-chip ${index === 0 ? 'is-active' : ''}`}
      type="button"
      data-filter={type.value}
      aria-pressed={index === 0 ? 'true' : 'false'}
    >
      {type.label}
    </button>
  ))}
</div>

<style>
  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-chip {
    background: rgba(148, 163, 184, 0.12);
    color: var(--muted);
    border-color: rgba(148, 163, 184, 0.3);
    cursor: pointer;
  }

  .filter-chip.is-active {
    color: var(--accent);
    border-color: rgba(125, 211, 252, 0.45);
    background: rgba(125, 211, 252, 0.12);
  }

  .filter-chips.is-compact .filter-chip {
    font-size: var(--text-xs);
    padding: 0.2rem 0.55rem;
  }
</style>
