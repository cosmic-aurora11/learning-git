---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Lore Coming Soon | The Arcane Atlas" robots="noindex, nofollow">
  <section class="section page-hero">
    <div class="container">
      <span class="chip">Lore Teaser</span>
      <h1>Living lore is on its way.</h1>
      <p class="muted">
        The scribes are still stitching together the next canon drop. Expect region guides,
        faction dossiers, and strange rumors soon.
      </p>
      <div style="display:flex; gap:1rem; flex-wrap:wrap; margin-top:1.5rem;">
        <a class="button primary" href="/">Return home</a>
        <a class="button" href="/recaps">Read the latest recap</a>
      </div>
    </div>
  </section>
</BaseLayout>
