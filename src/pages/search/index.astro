---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Search | The Arcane Atlas">
  <section class="section page-hero">
    <div class="container">
      <h1>Search</h1>
      <p class="muted">Search recaps, characters, lore, and more. Results update as you type.</p>
      <div class="card">
        <label class="sr-only" for="search-input">Search the The Arcane Atlas</label>
        <input id="search-input" type="search" placeholder="Search by title, tag, or summary..." />
        <p class="muted" id="result-count"></p>
      </div>
      <div id="search-results" class="search-results" aria-live="polite"></div>
    </div>
  </section>
</BaseLayout>

<script>
  const input = document.getElementById('search-input');
  const results = document.getElementById('search-results');
  const resultCount = document.getElementById('result-count');

  const params = new URLSearchParams(window.location.search);
  const initialQuery = params.get('q') || '';
  input.value = initialQuery;

  const renderResults = (items) => {
    results.innerHTML = items
      .map(
        (item) => `
        <article class="search-result" tabindex="0">
          <div class="chip">${item.type}</div>
          <h3><a href="${item.url}">${item.title}</a></h3>
          <p>${item.snippet}</p>
        </article>
      `
      )
      .join('');
  };

  const runSearch = async () => {
    const query = input.value.toLowerCase();
    const base = import.meta.env.BASE_URL;
    const response = await fetch(`${base}search-index.json`);
    const data = await response.json();
    const filtered = data.filter((item) => {
      return [item.title, item.summary, item.snippet].some((field) =>
        (field || '').toLowerCase().includes(query)
      );
    });

    resultCount.textContent = query
      ? `${filtered.length} result${filtered.length === 1 ? '' : 's'} for "${query}"`
      : 'Start typing to search the archive.';
    renderResults(filtered);
  };

  input.addEventListener('input', runSearch);
  runSearch();
</script>

<style>
  input[type='search'] {
    width: 100%;
    padding: 0.8rem 0.9rem;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--surface-alt);
    color: inherit;
  }

  .muted {
    color: var(--muted);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
</style>

