---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const workouts = await getCollection('workouts');
const categories = ['Table teamwork', 'Roleplay reps', 'Combat fundamentals', 'Spellcasting clarity'];
const grouped = await Promise.all(
  categories.map(async (category) => {
    const entries = workouts.filter((workout) => workout.data.category === category);
    const renderedEntries = await Promise.all(
      entries.map(async (entry) => ({ entry, Content: (await entry.render()).Content }))
    );
    return { category, entries: renderedEntries };
  })
);
---

<BaseLayout title="Player's Gym | The Arcane Atlas">
  <section class="section page-hero">
    <div class="container">
      <h1>Player's Gym</h1>
      <p class="muted">
        Five minutes here pays dividends at the table. 
        Choose a quick drill, warm up your imagination, and return to play more decisive, more immersed, and more engaged.
      </p>
      {grouped.map((group) => (
        <section style="margin-top:2rem;">
          <h2>{group.category}</h2>
          <div class="grid grid-2" style="margin-top:1rem;">
            {group.entries.map(({ entry, Content }) => (
              <article class="card">
                <h3>{entry.data.title}</h3>
                <p class="muted">{entry.data.summary}</p>
                <Content />
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .muted {
    color: var(--muted);
  }
</style>
