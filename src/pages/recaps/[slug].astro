---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const recaps = await getCollection('recaps');
  return recaps.map((recap) => ({
    params: { slug: recap.slug },
    props: { recap }
  }));
}

const { recap } = Astro.props;
const allRecaps = await getCollection('recaps');
const sortedRecaps = allRecaps.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
const index = sortedRecaps.findIndex((item) => item.slug === recap.slug);
const previous = sortedRecaps[index + 1];
const next = sortedRecaps[index - 1];
const sessionDisplay = recap.data.sessionLabel ?? recap.data.sessionNumber;
const dateDisplay = recap.data.dateLabel ?? recap.data.date;
const { Content } = await recap.render();
---

<BaseLayout title={`${recap.data.title} | The Arcane Atlas`}>
  <section class="section page-hero">
    <div class="container">
      <a class="chip" href="/recaps">← Back to recaps</a>
      <div class="card" style="margin-top:1.5rem;">
        <h1>{recap.data.title}</h1>
        <p class="muted">Session #: {sessionDisplay} | Date: {dateDisplay}</p>
      </div>
      <article class="section recap-content">
        <Content />
      </article>
      <nav class="grid grid-2" aria-label="Recap navigation">
        {previous ? (
          <a class="card" href={`/recaps/${previous.slug}`}>
            <p class="muted">Previous</p>
            <p class="recap-nav-date">{previous.data.date}</p>
            <strong class="recap-nav-title">{previous.data.title}</strong>
          </a>
        ) : (
          <div class="card" aria-disabled="true">
            <p class="muted">Previous</p>
            <strong>None yet</strong>
          </div>
        )}
        {next ? (
          <a class="card" href={`/recaps/${next.slug}`}>
            <p class="muted">Next</p>
            <p class="recap-nav-date">{next.data.date}</p>
            <strong class="recap-nav-title">{next.data.title}</strong>
          </a>
        ) : (
          <div class="card" aria-disabled="true">
            <p class="muted">Next</p>
            <strong>None yet</strong>
          </div>
        )}
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .muted {
    color: var(--muted);
  }

  .recap-content ul li + li {
    margin-top: 10px;
  }

  .recap-nav-date {
    margin: 0.25rem 0 0;
    font-size: 0.85rem;
    color: var(--muted);
    opacity: 0.8;
  }

  .recap-nav-title {
    display: block;
    margin-top: 0.35rem;
    white-space: normal;
    word-break: break-word;
  }
</style>
