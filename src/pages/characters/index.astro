---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PartyGoldWidget from '../../components/PartyGoldWidget.astro';
import CharacterCard from '../../components/CharacterCard.astro';
import { getCollection } from 'astro:content';

const characters = await getCollection('characters');
const characterOrder = ['rock', 'pompo', 'macha', 'eris'];
const orderedCharacters = [...characters].sort((a, b) => {
  const aIndex = characterOrder.indexOf(a.slug);
  const bIndex = characterOrder.indexOf(b.slug);
  if (aIndex === -1 && bIndex === -1) {
    return a.data.name.localeCompare(b.data.name);
  }
  if (aIndex === -1) return 1;
  if (bIndex === -1) return -1;
  return aIndex - bIndex;
});
---

<BaseLayout title="Characters | The Arcane Atlas">
  <section class="section page-hero">
    <div class="container">
      <h1>Characters</h1>
      <p class="muted">Your party roster, spotlight moments, and future allies.</p>
      <div style="margin:1.5rem 0 2rem;">
        <PartyGoldWidget />
      </div>
      <div class="grid grid-4">
        {orderedCharacters.map((character) => (
          <CharacterCard character={character} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .muted {
    color: var(--muted);
  }
</style>

